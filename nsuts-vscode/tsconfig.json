{
    "compilerOptions": {
        "types": [
            "node",
            "mocha",
            "@wdio/globals/types",
            "@wdio/mocha-framework",
            "wdio-vscode-service",
            "expect-webdriverio",
        ],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "ES2022",
        "esModuleInterop": true,
        "outDir": "out",
        "skipLibCheck": true,
        "lib": ["ES2022"],
        "rootDir": "./",
        "sourceMap": true,
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "declaration": true,
    },
    "include": ["./src/**/*", "./test/**/*.ts", "wdio.conf.ts"],
    "exclude": ["node_modules"]
}
